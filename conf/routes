# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~



# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)




POST     /check-in         controllers.VisitController.checkIn

GET      /visits           controllers.VisitController.getAllVisits

GET      /visits/:id       controllers.VisitController.getVisitById(id: Long)

POST    /visits/:id/request-vehicle    controllers.VisitController.requestVehicle(id: Long)

POST    /visits/:id/acknowledge        controllers.VisitController.acknowledgeRequest(id: Long)

POST    /visits/:id/ready              controllers.VisitController.ready(id: Long)

POST    /visits/:id/add-on             controllers.VisitController.addOn(id: Long)

POST    /visits/:id/check-out          controllers.VisitController.checkOut(id: Long)