GET     /api/admin/users/pending     controllers.AuthController.getPendingUsers

+ nocsrf
POST    /api/admin/users/:id/role    controllers.AuthController.assignRole(id: Long)

+ nocsrf
POST    /visits/check-in             controllers.VisitController.checkIn
